geom_segment(aes(x = -5, xend = 0.5, y = 0.6224593, yend = 0.6224593),
color = "blue",
linetype = 2) +
labs(x = expression(theta),
y = expression(P(Y[ni] == 1)),
color = "Item")
itemplot(eco_rasch,6, type='info', main = "Iteminformation")
eco_rasch <-  mirt(dat_eco_dicho[12:20], 1, itemtype = "Rasch", SE = TRUE)
# Fit indices
print(eco_rasch)
# item parameters
item_par_eco_rasch <- coef(eco_rasch, IRTpars=TRUE, simplify=TRUE)
item_par_eco_rasch
# ICCs
itemplot(eco_rasch, 6, type="trace")
itemplot(eco_rasch, "Eco_cog_6_dicho", type="trace")
