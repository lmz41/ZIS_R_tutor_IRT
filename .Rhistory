## Example ICCs with different alphas
dat_2PL_ICCs <- data.frame(
thetas = rep(seq(-5,5,0.01), 3),
item = rep(c("Item 1", "Item 2", "Item 3"), each = 1001),
alphas = rep(c(0.5, 1, 1.5), each = 1001),
item_dif = rep(c(0), each = 1001)
)
dat_2PL_ICCs <- dat_2PL_ICCs %>%
mutate(prob = exp(alphas*(thetas-item_dif))/(1+exp(alphas*(thetas-item_dif)))
)
ggplot(dat_2PL_ICCs, aes(x = thetas, y = prob, color = item)) +
geom_line() +
theme_classic() +
labs(x = expression(theta),
y = expression(P(Y[ni] == 1)),
colour = "Items") +
scale_colour_discrete(
breaks = c("Item 1", "Item 2", "Item 3"),
labels = c(
expression("Item 1:" ~ alpha[i] == 0.5),
expression("Item 2:" ~ alpha[i] == 1),
expression("Item 3:" ~ alpha[i] == 1.5)
)
)
