library(ggplot2)
library(patchwork)
tangent_plot <- function(mu, sigma, x0) {
f   <- function(x) dnorm(x, mean = mu, sd = sigma)
df  <- function(x) -(x - mu) / sigma^2 * f(x)
d2f <- function(x) ((x - mu)^2 / sigma^4 - 1 / sigma^2) * f(x)
tangent  <- function(x) f(x0) + df(x0) * (x - x0)
parabola <- function(x) tangent(x) + 0.5 * d2f(x0) * (x - x0)^2
ggplot() +
geom_function(fun = f, linewidth = 1) +
geom_function(aes(colour = "1. Ableitung (Tangente)",
linetype = "1. Ableitung (Tangente)"),
fun = tangent, linewidth = 1.2) +
geom_function(aes(colour = "2. Ableitung (Krümmung)",
linetype = "2. Ableitung (Krümmung)"),
fun = parabola, linewidth = 1.2,
xlim = x0 + c(-1, 1) * sigma) +
annotate("point", x = x0, y = f(x0), size = 2) +
scale_colour_manual(values = c("red", "steelblue")) +
scale_linetype_manual(values = c("dashed", "dotted")) +
scale_x_continuous(limits = c(-3, 3)) +
coord_cartesian(ylim = c(0, 0.85)) +
theme_classic() +
labs(y = "log-likelihood", colour = NULL, linetype = NULL)
}
p1 <- tangent_plot(mu = 0, sigma = 1,   x0 = -0.5)
p2 <- tangent_plot(mu = 0, sigma = 0.5, x0 = -0.5)
(p1 | p2) + plot_layout(guides = "collect") & theme(legend.position = "bottom")
