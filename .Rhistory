install.packages("patchwork")
library(patchwork)
library(ggplot2)
library(patchwork)
tangent_plot <- function(mu, sigma, x0) {
f     <- function(x) dnorm(x, mean = mu, sd = sigma)
df    <- function(x) -(x - mu) / sigma^2 * f(x)
slope <- df(x0)
icept <- f(x0) - slope * x0
ggplot() +
geom_function(fun = f, linewidth = 1) +
geom_abline(slope = slope, intercept = icept,
colour = "red", linetype = "dashed", linewidth = 1.2) +
annotate("point", x = x0, y = f(x0), colour = "red", size = 2) +
xlim(-3, 3) +
theme_classic() +
labs(y = "log-likelihood")
}
p1 <- tangent_plot(mu = 0, sigma = 1-2, x0 = -0.5)
p2 <- tangent_plot(mu = 0, sigma = 0.5, x0 = -0.5)
p1 | p2
