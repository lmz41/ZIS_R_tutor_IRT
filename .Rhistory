library(ggplot2)
mu    <- 0
sigma <- 1
f  <- function(x) dnorm(x, mean = mu, sd = sigma) # Funktion
df <- function(x) -(x - mu) / sigma^2 * dnorm(x, mean = mu, sd = sigma) # erste Ableitung
x0    <- -0.5                    # Punkt, an dem die Tangente anliegt
slope <- df(x0)
icept <- f(x0) - slope * x0
ggplot() +
geom_function(fun = f, linewidth = 1) +
geom_abline(slope = slope, intercept = icept,
colour = "red", linetype = "dashed", linewidth = 1.2) +
annotate("point", x = x0, y = f(x0), colour = "red", size = 2) +
xlim(-3, 3) +
theme_classic() +
labs(y = "log-likelihood")
mu    <- 0
sigma <- 0.5
